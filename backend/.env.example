NODE_ENV=development
PORT=5000

# ─── MongoDB Atlas ───────────────────────────────────────────────────────────
# Password placeholder – set the real password in your local .env file only.
# Never commit real credentials.
MONGODB_URI=mongodb+srv://medivoice_admin:REPLACE_WITH_YOUR_PASSWORD@cluster0.ado0bej.mongodb.net/medivoice_ai?retryWrites=true&w=majority&appName=Cluster0

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_32_chars_minimum
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# ─── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Email (Nodemailer / SMTP) ────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_password
EMAIL_FROM=noreply@medivoice.ai

# ─── Twilio (SMS + Voice) ────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── WhatsApp (Twilio WhatsApp Business) ─────────────────────────────────────
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── OpenAI (AI Receptionist LLM) ────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# ─── ElevenLabs (Text-to-Speech) ─────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_voice_id

# ─── File Storage ────────────────────────────────────────────────────────────
# LOCAL_UPLOAD_DIR is used in development; swap to S3/GCS in production
LOCAL_UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ─── OTP ─────────────────────────────────────────────────────────────────────
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
